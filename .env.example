# Copiá este archivo como ".env" y completá los valores.
# El .env está en .gitignore: nunca se sube al repositorio.

# Token que te da @BotFather al crear el bot (formato 123456789:ABC-...).
TELEGRAM_BOT_TOKEN=

# Tu chat ID numérico. Si no lo sabés, arrancá el bot y mandale /chatid.
TELEGRAM_CHAT_ID=

# (Etapa 3) Clave de la API de Claude para clasificar el sentimiento de noticias.
# Se crea en https://console.anthropic.com (es un servicio pago por uso).
# Sin esta clave, las noticias se muestran igual pero sin puntaje.
ANTHROPIC_API_KEY=

# (Opcionales) Más fuentes de noticias, con plan gratuito:
# https://finnhub.io  -  https://www.marketaux.com  -  https://newsapi.org
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
NEWSAPI_KEY=
